# Film Adviser — environment variables
# Copy to .env and fill in your values. Never commit .env to git.

# ── Required ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./film_adviser.db
# For production use PostgreSQL: postgresql://user:password@host/dbname

# ── AI Services ───────────────────────────────────────────────────────────────
GEMINI_API_KEY=
TMDB_API_KEY=

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-in-production
